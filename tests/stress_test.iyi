module tests/stress_test

import std/time::{Time}
import src/tui::*

def assert_eq(actual, expected, msg : String) : Nil
  raise "Assertion failed: #{msg} (expected: #{expected.inspect}, got: #{actual.inspect})" unless actual == expected
end

def assert_true(cond : Bool, msg : String) : Nil
  raise "Assertion failed: #{msg}" unless cond
end

test "Stress: Viewport handles 10,000 lines and 500 scroll frames quickly" do
  lines = Array(String).new(10000) { |i| "[#{i}] Log line payload with ANSI " + Style.new_style.foreground(Theme.iyi.secondary).render("ok") }
  t0 = Time.monotonic
  vp = Viewport.new(lines, offset: 0, width: 64, height: 20)
  500.times do |step|
    vp = vp.scroll_down(15)
    frame = vp.render(focused: true)
    assert_true(!frame.empty?, "frame #{step} non-empty") if step == 499
  end
  elapsed_ms = (Time.monotonic - t0).total_milliseconds
  assert_true(elapsed_ms < 2000.0, "500 frames over 10k-line Viewport should complete well under 2s (took #{elapsed_ms}ms)")
end

test "Stress: FilterList filters 1,000 items rapidly across progressive typing" do
  items = Array(String).new(1000) { |i| "component_module_item_#{i}" }
  t0 = Time.monotonic
  fl = FilterList.new(items)
  ["m", "o", "d", "u", "l", "e", "_", "i", "t", "e", "m", "_", "9", "9"].each do |ch|
    fl = fl.handle_key(KeyEvent.parse(ch))
    _ = fl.render(max_visible: 8)
  end
  elapsed_ms = (Time.monotonic - t0).total_milliseconds
  assert_eq(fl.filtered_items.size, 11, "'module_item_99' matches 99 and 990..999 (11 items)")
  assert_true(elapsed_ms < 2000.0, "progressive filtering over 1k items should complete well under 2s (took #{elapsed_ms}ms)")
end

test "Stress: TextArea handles 200 sequential UTF-8 edits and newlines without drift" do
  ta = TextArea.new([""], 0, 0, 48, 12)
  t0 = Time.monotonic
  200.times do |i|
    ta = ta.insert_text("satır_#{i}_ğüş")
    ta = ta.insert_newline if i < 199
  end
  rendered = ta.render(focused: true)
  elapsed_ms = (Time.monotonic - t0).total_milliseconds
  assert_eq(ta.line_count, 200, "200 lines created")
  assert_eq(rendered.split('\n').size, 12, "rendered height matches viewport height 12")
  assert_true(elapsed_ms < 2000.0, "200 multi-line UTF-8 edits should complete well under 2s (took #{elapsed_ms}ms)")
end

test "Stress: Table renders 1,000 rows windowed at 15 rows with consistent box geometry" do
  cols = [TableColumn.new("ID", 6, :right), TableColumn.new("NAME", 18, :left), TableColumn.new("STATUS", 10, :center)]
  rows = Array(Array(String)).new(1000) { |i| ["#{i}", "module_#{i}", "Active"] }
  t0 = Time.monotonic
  tbl = Table.new(cols, rows, 500)
  out = tbl.render(focused: true, max_visible_rows: 15)
  elapsed_ms = (Time.monotonic - t0).total_milliseconds
  out_lines = out.split('\n')
  assert_eq(out_lines.size, 17, "header + divider + 15 rows")
  w0 = Ansi.visible_width(out_lines[0])
  out_lines.each_with_index do |l, idx|
    assert_eq(Ansi.visible_width(l), w0, "row #{idx} width must match header")
  end
  assert_true(elapsed_ms < 2000.0, "1000-row windowed Table render should complete well under 2s (took #{elapsed_ms}ms)")
end

test "Stress: 1,000 chained Style.render calls preserve exact geometry and performance" do
  t0 = Time.monotonic
  style = Style.new_style
    .bold
    .foreground(Theme.iyi.text)
    .background(Theme.iyi.surface)
    .border(:rounded)
    .border_foreground(Theme.iyi.primary)
    .padding(1, 2)
    .width(36)
    .align(:center)

  last = ""
  1000.times do |i|
    last = style.render("Frame #{i}\n" + Style.new_style.foreground(Theme.iyi.secondary).render("iyi-tui"))
  end
  elapsed_ms = (Time.monotonic - t0).total_milliseconds
  assert_eq(last.split('\n').size, 6, "2 content + 2 pad + 2 border = 6 lines")
  assert_true(elapsed_ms < 2000.0, "1000 complex Style.render calls should complete well under 2s (took #{elapsed_ms}ms)")
end
